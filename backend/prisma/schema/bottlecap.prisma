model BottleCap {
  bottleCapId Int      @id @default(autoincrement()) @map("bottle_cap_id")
  createdAt   DateTime @default(now()) @map("created_at")

  controllerCode String     @map("controller_code")
  controller     Controller @relation(fields: [controllerCode], references: [code])

  @@map("bottle_cap")
}
