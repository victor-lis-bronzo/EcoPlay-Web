model Controller {
  code          String   @id @unique
  controllerId  Int      @default(autoincrement()) @map("controller_id")
  name          String
  status        Boolean
  createdAt     DateTime @default(now()) @map("created_at")
  institutionId Int      @map("institution_id")

  Institution Institution @relation(fields: [institutionId], references: [institutionId])
  bottles_cap BottleCap[]

  @@map("controller")
}
