{
  "$schema": "https://json.schemastore.org/tsconfig",
  "exclude": ["node_modules", "dist", "./prisma/*"],
  "compilerOptions": {
    "module": "es2022",
    "moduleResolution": "bundler",
    "target": "es2022",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@prisma-client/*": ["./prisma/*"]
    },
    "resolveJsonModule": true
  }
}
