model BottleCap {
  bottleCapId Int      @id @default(autoincrement()) @map("bottle_cap_id")
  createdAt   DateTime @default(now()) @map("created_at")

  controllerCode String     @map("controller_code")
  controller     Controller @relation(fields: [controllerCode], references: [code])

  @@map("bottle_cap")
}

model Controller {
  code          String   @id @unique
  controllerId  Int      @default(autoincrement()) @map("controller_id")
  name          String
  status        Boolean
  createdAt     DateTime @default(now()) @map("created_at")
  institutionId Int      @map("institution_id")

  Institution Institution @relation(fields: [institutionId], references: [institutionId])
  bottles_cap BottleCap[]

  @@map("controller")
}

model Institution {
  institutionId Int      @id @default(autoincrement()) @map("institution_id")
  name          String   @unique
  status        Boolean
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  controllers Controller[]
  operators   Operator[]

  @@map("institution")
}

model Operator {
  operatorId Int      @id @default(autoincrement()) @map("operator_id")
  username   String   @unique
  name       String
  password   String
  type       UserType @default(USER)
  status     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  institutionId Int?         @map("institution_id")
  Institution   Institution? @relation(fields: [institutionId], references: [institutionId])

  @@map("operator")
}

generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/client"
}

