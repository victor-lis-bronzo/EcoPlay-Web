{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "index.js",
  "prisma": {
    "schema": "./prisma/schema/"
  },
  "scripts": {
    "seed": "tsx services/seed.ts",
    "dev": "tsx watch src/app.ts",
    "build": "tsup src --format esm",
    "production": "npm i && npm run build",
    "start": "node dist/app.js",
    "generate": "pnpx prisma generate",
    "migrate": "pnpx prisma migrate",
    "studio": "pnpx prisma studio"
  },
  "tsup": {
    "entry": [
      "src/app.ts"
    ],
    "format": [
      "esm"
    ],
    "outDir": "dist",
    "clean": true,
    "dts": true,
    "sourcemap": true,
    "external": [
      "./prisma/generated/prisma/client"
    ],
    "target": "esnext"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.11.0",
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.15.17",
    "prisma": "^6.8.2",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/jwt": "^9.1.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.2",
    "@prisma/client": "^6.8.2",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.5.0",
    "mqtt": "^5.10.4",
    "fastify": "^5.3.2",
    "fastify-type-provider-zod": "^4.0.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "swagger-themes": "^1.4.3",
    "zod": "^3.25.1"
  }
}
